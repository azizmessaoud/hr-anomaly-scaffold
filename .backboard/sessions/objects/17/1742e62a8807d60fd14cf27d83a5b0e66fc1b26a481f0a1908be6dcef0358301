from __future__ import annotations

from unittest.mock import MagicMock, patch

import httpx
import pytest
from fastapi.testclient import TestClient

from app.main import create_app


@pytest.fixture
def client() -> TestClient:
    return TestClient(create_app())


# ---------------------------------------------------------------------------
# /health/live — process-only liveness, no dep checks
# ---------------------------------------------------------------------------


def test_health_live_returns_ok(client: TestClient):
    response = client.get("/health/live")
    assert response.status_code == 200
    body = response.json()
    assert body["status"] == "ok"
    assert "app" in body


def test_health_live_does_not_call_out_to_dependencies(client: TestClient):
    """``/health/live`` must not touch the network or probe Docling.
    A live probe that depends on Ollama is not a live probe — it's a
    readiness probe in disguise."""
    with patch("app.core.health._docling_importable") as docling_mock:
        with patch("app.core.health._vlm_reachable") as vlm_mock:
            response = client.get("/health/live")
    assert response.status_code == 200
    docling_mock.assert_not_called()
    vlm_mock.assert_not_called()


# ---------------------------------------------------------------------------
# /health — back-compat shim, identical to /health/live
# ---------------------------------------------------------------------------


def test_health_backcompat_returns_same_as_live(client: TestClient):
    """Older clients hit ``/health`` directly; keep returning the same
    body so they don't break."""
    live = client.get("/health/live").json()
    legacy = client.get("/health").json()
    assert legacy == live


# ---------------------------------------------------------------------------
# /health/ready — mode-aware readiness probe
# ---------------------------------------------------------------------------


def test_health_ready_returns_200_when_docling_available(client: TestClient):
    """If Docling import works and VLM is disabled, the probe is ready."""
    with patch("app.core.health._docling_importable", return_value=True):
        with patch("app.core.health._vlm_reachable", return_value=True):
            response = client.get("/health/ready")

    assert response.status_code == 200
    body = response.json()
    assert body["status"] == "ready"
    assert body["checks"]["docling"]["available"] is True
    assert body["checks"]["docling"]["required"] is True


def test_health_ready_returns_503_when_docling_missing(client: TestClient):
    """Missing Docling = hard dep failure = 503."""
    with patch("app.core.health._docling_importable", return_value=False):
        response = client.get("/health/ready")

    assert response.status_code == 503
    body = response.json()
    assert body["status"] == "not_ready"
    assert body["checks"]["docling"]["available"] is False


def test_health_ready_returns_200_degraded_when_vlm_unreachable(client: TestClient):
    """VLM unreachable is a soft dep — 200 with degraded detail, not 503."""
    with patch("app.core.health._docling_importable", return_value=True):
        with patch("app.core.health._vlm_reachable", return_value=False):
            response = client.get("/health/ready")

    assert response.status_code == 200
    body = response.json()
    assert body["status"] == "degraded"
    assert body["checks"]["vlm"]["available"] is False
    assert body["checks"]["vlm"]["required"] is False


def test_health_ready_reports_mode_when_vlm_enabled(client: TestClient, monkeypatch: pytest.MonkeyPatch):
    """When ``VLM_ENABLED=true`` the probe reports the VLM-aware mode."""
    monkeypatch.setenv("VLM_ENABLED", "true")
    monkeypatch.setenv("OLLAMA_BASE_URL", "http://example:11434")
    with patch("app.core.health._docling_importable", return_value=True):
        with patch("app.core.health._vlm_reachable", return_value=True):
            response = client.get("/health/ready")

    body = response.json()
    assert body["mode"] == "demo_with_vlm"
    assert body["checks"]["vlm"]["enabled"] is True


def test_health_ready_reports_mode_when_vlm_disabled(client: TestClient, monkeypatch: pytest.MonkeyPatch):
    """When ``VLM_ENABLED=false`` the probe reports Docling-only mode and
    treats VLM as enabled-and-OK (skipping the network probe)."""
    monkeypatch.setenv("VLM_ENABLED", "false")
    monkeypatch.setenv("OLLAMA_BASE_URL", "http://example:11434")
    with patch("app.core.health._docling_importable", return_value=True):
        with patch("app.core.health._vlm_reachable", return_value=True):
            response = client.get("/health/ready")

    body = response.json()
    assert body["mode"] == "docling_only_demo"
    assert body["checks"]["vlm"]["enabled"] is False


# ---------------------------------------------------------------------------
# Direct unit tests for the VLM reachability probe (no FastAPI)
# ---------------------------------------------------------------------------


def test_vlm_reachable_returns_false_on_connection_error():
    """A network exception must short-circuit to False without raising."""
    from app.core.config import ExtractPipelineConfig
    from app.core.health import _vlm_reachable

    config = ExtractPipelineConfig(
        docling_confidence_threshold=0.75,
        vlm_enabled=True,
        ollama_base_url="http://127.0.0.1:1",
        ollama_model="x",
        ollama_timeout_seconds=1,
        vlm_default_confidence=0.5,
    )
    with patch("app.core.health.httpx.get", side_effect=httpx.ConnectError("nope")):
        assert _vlm_reachable(config) is False


def test_vlm_reachable_returns_true_when_disabled():
    """When ``VLM_ENABLED=false`` the probe must not even attempt the
    network call — disabled is not unreachable."""
    from app.core.config import ExtractPipelineConfig
    from app.core.health import _vlm_reachable

    config = ExtractPipelineConfig(
        docling_confidence_threshold=0.75,
        vlm_enabled=False,
        ollama_base_url="http://127.0.0.1:1",
        ollama_model="x",
        ollama_timeout_seconds=1,
        vlm_default_confidence=0.5,
    )
    assert _vlm_reachable(config) is True