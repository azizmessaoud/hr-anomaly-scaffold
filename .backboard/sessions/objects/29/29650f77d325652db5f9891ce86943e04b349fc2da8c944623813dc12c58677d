"""Runtime health/readiness probes.

Seam: ``app.main`` calls ``liveness()`` / ``readiness()`` and returns the
result. All hard/soft dependency classification lives here so the contract
in ``docs/runtime.md`` has a single code-side definition.

Liveness (``/health/live``) — process-only: always 200 unless the server
itself is wedged. Does not check dependencies.

Readiness (``/health/ready``) — mode-aware: returns 503 only when a *hard*
dependency of the active runtime mode is missing, and 200 (possibly with
``degraded=true``) when optional dependencies are down.

Demo mode hard deps (current implementation):
    - Docling importable and ``DocumentConverter`` instantiable.

Demo mode optional deps:
    - VLM (Ollama reachable at ``ollama_base_url``).
    - Redis / Postgres / Celery — not yet wired (full-stack mode planned).
"""
from __future__ import annotations

import logging
from typing import Literal

import httpx

from app.core.config import ExtractPipelineConfig, Settings, make_extract_pipeline_config

logger = logging.getLogger(__name__)


def _docling_importable() -> bool:
    """True if Docling can be imported and ``DocumentConverter`` is reachable.

    This is the only hard dep in demo mode: without Docling, no record can
    be extracted and the pipeline must not accept uploads.
    """
    try:
        from docling.document_converter import DocumentConverter  # noqa: F401
    except Exception as exc:  # pragma: no cover - exercised via tests
        logger.debug("Docling import failed in readiness check: %s", exc)
        return False
    return True


def _vlm_reachable(config: ExtractPipelineConfig, timeout: float = 1.0) -> bool:
    """Best-effort liveness check on the VLM HTTP endpoint.

    Soft dep: failures only set ``degraded=true``, they do not 503 the
    readiness probe. We deliberately use a short timeout so the probe
    never blocks the event loop for long.
    """
    if not config.vlm_enabled:
        return True  # disabled is not "unreachable"
    try:
        response = httpx.get(config.ollama_base_url, timeout=timeout)
        return response.status_code < 500
    except Exception as exc:  # pragma: no cover - network-dependent
        logger.debug("VLM reachability probe failed: %s", exc)
        return False


def liveness() -> dict[str, object]:
    """Process-only liveness probe — always 200 unless the server is wedged.

    No dependency checks here. If this endpoint stops responding, the
    process itself is hung; everything else is irrelevant.
    """
    settings = Settings()
    return {"status": "ok", "app": settings.app_name}


def readiness() -> tuple[Literal[200, 503], dict[str, object]]:
    """Mode-aware readiness probe.

    Returns ``(status_code, body)``. The body is shaped::

        {
            "status": "ready" | "not_ready" | "degraded",
            "mode": "docling_only_demo" | ...,
            "checks": {
                "docling": {"available": bool, "required": True},
                "vlm":     {"available": bool, "required": False},
                ...
            }
        }

    The probe is 503 only when a *required* check fails. Soft checks
    surface as ``degraded=true`` with HTTP 200.
    """
    settings = Settings()
    config = make_extract_pipeline_config(settings)

    mode = "docling_only_demo" if not config.vlm_enabled else "demo_with_vlm"

    checks: dict[str, dict[str, object]] = {
        "docling": {
            "available": _docling_importable(),
            "required": True,
        },
        "vlm": {
            "available": _vlm_reachable(config),
            "required": False,
            "url": config.ollama_base_url,
            "enabled": config.vlm_enabled,
        },
    }

    hard_failed = any(
        check["required"] and not check["available"] for check in checks.values()
    )
    soft_failed = any(
        not check["required"] and not check["available"] for check in checks.values()
    )

    if hard_failed:
        status_code: Literal[200, 503] = 503
        status_label = "not_ready"
    elif soft_failed:
        status_code = 200
        status_label = "degraded"
    else:
        status_code = 200
        status_label = "ready"

    return status_code, {
        "status": status_label,
        "mode": mode,
        "checks": checks,
    }