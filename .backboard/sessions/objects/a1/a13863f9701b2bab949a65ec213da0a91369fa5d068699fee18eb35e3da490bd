from __future__ import annotations

from app.ingestion.schemas import HRRecord

# Shared completeness rule for current payroll/onboarding family.
REQUIRED_PAYROLL_FIELDS = ("nom", "cin", "cnss", "date_embauche", "salaire_brut")

# RapidOCR hard gate: any of these missing fails the RapidOCR result outright (RED).
RAPIDOCR_HARD_GATE_FIELDS = ("nom", "cin", "cnss")


def missing_required_fields(
    record: HRRecord, fields: tuple[str, ...] = REQUIRED_PAYROLL_FIELDS
) -> list[str]:
    return [name for name in fields if getattr(record, name) is None]
