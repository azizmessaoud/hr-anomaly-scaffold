[project]
name = "hr-anomaly-pipeline"
version = "0.1.0"
description = "Outil de detection des anomalies dans les fichiers RH"
requires-python = ">=3.11"
license = { text = "MIT" }

[dependency-groups]
dev = [
    "pytest>=8",
    "pytest-cov",
    "ruff",
    "mypy>=1.9",
    "httpx",
    "types-redis",
]
main = [
    "fastapi>=0.111",
    "uvicorn[standard]>=0.30",
    "celery[redis]>=5.4",
    "redis>=5",
    "pydantic>=2.7",
    "pydantic-settings>=2.3",
    "docling>=2",
    "pymupdf>=1.23",
    "ollama>=0.4",
    "pandas>=2.2",
    "pandera>=0.20",
    "pyod>=2",
    "scikit-learn>=1.5",
    "statsmodels>=0.14",
    "python-multipart>=0.0.9",
    " Pillow>=10",
]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project.scripts]
hr-pipeline = "app.main:run"

[tool.ruff]
target-version = "py311"
line-length = 100

[tool.ruff.lint]
select = ["E", "F", "I", "UP"]
ignore = ["E501"]

[tool.mypy]
strict = true
python_version = "3.11"
ignore_missing_imports = true

[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = "-q"
